# ============================================================
# Firecracker VM Environment Variables
# ============================================================
# This is the single source of truth for all secrets and
# configuration injected into the VM at build time.
# Copy to .env and fill in your values.
# ============================================================

# --- API Keys (provider-based naming) ---
# Add new keys following the same pattern: <PROVIDER>_API_KEY
VENICE_API_KEY=""

# --- Git Identity ---
GIT_NAME=""
GIT_EMAIL=""

# --- SearXNG (inherited by PI agent & systemd service) ---
SEARXNG_HOST="127.0.0.1"
SEARXNG_PORT="8888"
