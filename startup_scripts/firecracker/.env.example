# ============================================================
# Firecracker VM Environment Variables
# ============================================================
# Single source of truth for secrets and configuration injected
# into the VM at build time, plus the host-side values used by
# nfs-share.sh (see the File sharing section below).
# Copy to .env and fill in your values.
# ============================================================

# --- API Keys (provider-based naming) ---
# Add new keys following the same pattern: <PROVIDER>_API_KEY
VENICE_API_KEY=""
OPENROUTER_API_KEY=""
# Note: config/pi/models.json references OPENROUTER_API_KEY1 (deliberately
# unsatisfied) so openrouter models stay out of Pi's model list.

# --- Git Identity ---
GIT_NAME=""
GIT_EMAIL=""

# --- SearXNG (inherited by PI agent & systemd service) ---
SEARXNG_HOST="127.0.0.1"
SEARXNG_PORT="8888"

# --- File sharing to the VM (host side, used by nfs-share.sh) ---
# NFS_RO_PATH:     host path of the read-only media library (any filesystem)
# NFS_SERVE_USER:  host account the rclone ro service runs as; it must be able
#                  to read the media files (udisks mounts them owned by this user)
# NFS_SQUASH_UID:  uid the NFS rw export squashes requests to (dedicated
#                  unprivileged user created by `nfs-share.sh setup`)
NFS_RO_PATH=""
NFS_SERVE_USER=""
NFS_SQUASH_UID=""
