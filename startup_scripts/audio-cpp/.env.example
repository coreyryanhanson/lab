# Directory containing the audio.cpp model files (gitignored).
# Absolute path recommended — start.sh runs the server from audio.cpp/,
# so relative .env paths would resolve from there.
# Expected layout for the defaults in models.json:
#   ${AUDIO_MODELS_DIR}/qwen3-asr-1.7b-q8_0.gguf
#   ${AUDIO_MODELS_DIR}/qwen3-forced-aligner-0.6b-q8_0.gguf   (word timestamps)
#   ${AUDIO_MODELS_DIR}/nemotron-3-diarization-bf16.gguf
# All resident at once need ~5 GB VRAM (fits 16 GB RTX 4090 laptop easily).
# Silero VAD for timestamp chunking is resolved from the audio.cpp repo
# checkout automatically (start.sh runs the server from its root).
AUDIO_MODELS_DIR=""
